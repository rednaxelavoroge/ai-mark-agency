# Inbox that receives landing briefs
CONTACT_TO_EMAIL=hello@ai-mark.agency

# Optional From: address (must be allowed by your provider)
CONTACT_FROM_EMAIL=AI Mark Agency <noreply@ai-mark.agency>

# Option A — Resend (https://resend.com)
RESEND_API_KEY=

# Option B — POST JSON { subject, text, to } to any webhook (Zapier, Make, Slack)
CONTACT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Partner Platform — Supabase
# ---------------------------------------------------------------------------
# Current Supabase API keys (short opaque strings, NOT `eyJ…` JWTs):
#   sb_publishable_…  low privilege, safe to ship; RLS decides what it reaches
#   sb_secret_…       elevated, BYPASSES RLS; must never leave the server
#
# The public website builds and serves without any of these. When they are
# missing, /auth/* shows a "not usable" notice and /partner, /admin redirect to
# the login page, so `npm run build` stays green.
#
# Apply the schema first — see supabase/README.md.
# Never commit real values: `.env*.local` is gitignored.

# Safe to expose to the browser. RLS is the boundary, so this is intended.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, and optional — falls back to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Server-only. This key MAPS TO service_role AND BYPASSES Row Level Security.
#   * never prefix it with NEXT_PUBLIC_ (that would inline it into the browser
#     bundle for every visitor)
#   * never read it in a client component — use lib/supabase/admin.ts, which is
#     `server-only` so a bad import fails the build
#   * set it on the server only: Vercel → Settings → Environment Variables,
#     or `.env.local` for local development
#
# Phase 4B (referral engine) DOES use it in the running app: /go/<code> records
# a click, /api/contact records a lead, and partner signup creates the sponsor
# edge — all writes that Row Level Security deliberately refuses to a browser
# session. Without it those features degrade to "redirect works, nothing is
# tracked"; the public site and `npm run build` stay green either way.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Partner Platform — referral attribution (Phase 4B)
# ---------------------------------------------------------------------------
# Optional but recommended. Signs the first-party attribution cookie (HMAC).
# A dedicated value lets you rotate the cookie key without touching the
# database key. When it is unset the Supabase secret key above is used instead;
# when neither is set no attribution cookie is issued at all (an unsigned
# cookie would let a visitor choose their own referral code).
#
# Generate one with:  openssl rand -base64 48
REFERRAL_COOKIE_SECRET=

# ---------------------------------------------------------------------------
# Treasury receive addresses (AI MARK wallets — not a merchant custodian)
# ---------------------------------------------------------------------------
# Public addresses only. Never put a private key here. Empty means that
# rail is not offered; the pay UI stays up and will not invent an address.
# Stripe is later and must stay unset.

TREASURY_USDT_TRON=
TREASURY_USDT_ETHEREUM=
TREASURY_USDT_POLYGON=
TREASURY_USDT_SOLANA=
TREASURY_USDT_BNB=
TREASURY_USDT_TON=
TREASURY_USDC_TRON=
TREASURY_USDC_ETHEREUM=
TREASURY_USDC_POLYGON=
TREASURY_USDC_SOLANA=
TREASURY_USDC_BNB=
TREASURY_USDC_TON=

# Optional JSON-RPC for a Solana signature lookup on /admin/invoices.
# Does not send tokens. Leave empty to keep matching manual (tx hash).
SOLANA_RPC_URL=
