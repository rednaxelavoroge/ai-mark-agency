# Inbox that receives landing briefs
# Production on Vercel: Project → Settings → Environment Variables → Production
# (and Preview if you want Preview forms to notify too).
# Delivery needs CONTACT_TO_EMAIL plus RESEND_API_KEY, or CONTACT_WEBHOOK_URL.
# Without a provider, production POST /api/contact returns HTTP 503, notified=false.
CONTACT_TO_EMAIL=hello@ai-mark.agency

# Optional From: address. Must be on a domain verified in Resend
# (currently auth.ai-mark.agency — the apex ai-mark.agency is not verified).
CONTACT_FROM_EMAIL=AI MARK <noreply@auth.ai-mark.agency>

# Option A — Resend (https://resend.com)
RESEND_API_KEY=

# Option B — POST JSON { subject, text, to } to any webhook (Zapier, Make, Slack)
CONTACT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Partner Platform — Supabase
# ---------------------------------------------------------------------------
# Current Supabase API keys (short opaque strings, NOT `eyJ…` JWTs):
#   sb_publishable_…  low privilege, safe to ship; RLS decides what it reaches
#   sb_secret_…       elevated, BYPASSES RLS; must never leave the server
#
# The public website builds and serves without any of these. When they are
# missing, /auth/* shows a "not usable" notice and /partner, /admin redirect to
# the login page, so `npm run build` stays green.
#
# Apply the schema first — see supabase/README.md.
# Never commit real values: `.env*.local` is gitignored.

# Safe to expose to the browser. RLS is the boundary, so this is intended.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, and optional — falls back to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Server-only. This key MAPS TO service_role AND BYPASSES Row Level Security.
#   * never prefix it with NEXT_PUBLIC_ (that would inline it into the browser
#     bundle for every visitor)
#   * never read it in a client component — use lib/supabase/admin.ts, which is
#     `server-only` so a bad import fails the build
#   * set it on the server only: Vercel → Settings → Environment Variables,
#     or `.env.local` for local development
#
# Phase 4B (referral engine) DOES use it in the running app: /go/<code> records
# a click, /api/contact records a lead, and partner signup creates the sponsor
# edge — all writes that Row Level Security deliberately refuses to a browser
# session. Without it those features degrade to "redirect works, nothing is
# tracked"; the public site and `npm run build` stay green either way.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Partner Platform — referral attribution (Phase 4B)
# ---------------------------------------------------------------------------
# Optional but recommended. Signs the first-party attribution cookie (HMAC).
# A dedicated value lets you rotate the cookie key without touching the
# database key. When it is unset the Supabase secret key above is used instead;
# when neither is set no attribution cookie is issued at all (an unsigned
# cookie would let a visitor choose their own referral code).
#
# Generate one with:  openssl rand -base64 48
REFERRAL_COOKIE_SECRET=

# ---------------------------------------------------------------------------
# Treasury receive addresses (AI MARK wallets — not a merchant custodian)
# ---------------------------------------------------------------------------
# Public addresses only. Never put a private key here. Empty means that
# rail is not offered; the pay UI stays up and will not invent an address.
# Stripe is later and must stay unset.

TREASURY_USDT_TRON=
TREASURY_USDT_ETHEREUM=
TREASURY_USDT_POLYGON=
TREASURY_USDT_SOLANA=
TREASURY_USDT_BNB=
TREASURY_USDT_TON=
TREASURY_USDC_TRON=
TREASURY_USDC_ETHEREUM=
TREASURY_USDC_POLYGON=
TREASURY_USDC_SOLANA=
TREASURY_USDC_BNB=
TREASURY_USDC_TON=

# Optional JSON-RPC for a Solana signature lookup on /admin/invoices.
# Does not send tokens. Leave empty to keep matching manual (tx hash).
SOLANA_RPC_URL=

# ---------------------------------------------------------------------------
# Daily commission hold (Vercel Cron)
# ---------------------------------------------------------------------------
# Vercel sends Authorization: Bearer <CRON_SECRET> to
# GET /api/cron/advance-sponsor-lock. That route calls advance_sponsor_lock
# so the 14-day hold moves without a manual click. Generate one with:
#   openssl rand -base64 32
# Set the same value on the Vercel project. If it is unset, the route
# refuses every request.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Transactional email (partners, buyers, admin alerts)
# ---------------------------------------------------------------------------
# Uses Resend when RESEND_API_KEY is set (same as contact form). Optional
# dedicated From for product mail; falls back to CONTACT_FROM_EMAIL.
EMAIL_FROM=
# Inbox for manual provisioning alerts (falls back to CONTACT_TO_EMAIL).
ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Product tenant provisioning (phase 2)
# ---------------------------------------------------------------------------
AIME_PROVISIONING_URL=
AIME_PROVISIONING_SECRET=
ASSISTANT_PROVISIONING_URL=
ASSISTANT_PROVISIONING_SECRET=
SHOWROOM_PROVISIONING_URL=
SHOWROOM_PROVISIONING_SECRET=

# ---------------------------------------------------------------------------
# Marketer (AIME) pipeline — see docs/marketer-setup.md for exact setup URLs
# ---------------------------------------------------------------------------
# Research, audience analysis, strategy, content plan, post copy and reel
# scripts (capabilities 1-6, 12). Without it those steps return a clear
# "not configured" error and the pipeline stops before Telegram.
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-sonnet-5.
MARKETER_LLM_MODEL=

# Graphic design for posts (capability 7) — OpenAI, or OpenRouter as a
# drop-in. The call is the OpenAI image shape, so either account works:
#   OPENAI_API_KEY set            -> api.openai.com/v1 (wins if both are set,
#                                    so adding an OpenRouter key never
#                                    reroutes an existing OpenAI deployment)
#   only OPENROUTER_API_KEY set   -> openrouter.ai/api/v1
# Without either key a post still goes through Telegram approval with its
# caption; publishing then fails with a clear "no image generated" reason
# instead of posting a blank image.
OPENAI_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional override, applies to either provider. Defaults to gpt-image-1 on
# OpenAI and google/gemini-2.5-flash-image on OpenRouter.
MARKETER_IMAGE_MODEL=
# Optional OpenRouter model override (vendor/model slug), used as the
# fallback when MARKETER_IMAGE_MODEL is unset.
MARKETER_OPENROUTER_MODEL=

# Telegram approval (capability 8) and the reject-then-comment flow
# (capability 10). Create the bot with @BotFather, then register the webhook
# below pointing at /api/marketer/telegram/webhook. Each client's chat id is
# saved on their marketer_profiles row, not here — this is the bot account,
# shared by every client.
TELEGRAM_BOT_TOKEN=
# Generate with: openssl rand -base64 32
# Passed as `secret_token` when calling Telegram's setWebhook; Telegram echoes
# it back in X-Telegram-Bot-Api-Secret-Token on every webhook call, which is
# how the route rejects a forged POST.
TELEGRAM_WEBHOOK_SECRET=

# Instagram publish (capability 9) and Insights (capability 11) via the Meta
# Graph API. Per-client values (Instagram Business Account id + page access
# token) live on each marketer_profiles row, not here. This only overrides
# the Graph API version if Meta deprecates the default.
META_GRAPH_API_VERSION=
